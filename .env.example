# African Logistics Intelligence System - Environment Configuration
# Copy this file to .env and customize for your environment

# ==========================================
# Project Paths
# ==========================================
# Base directory for the project
# PROJECT_ROOT=C:/path/to/african-logistics-intelligence-start

# ==========================================
# Data Directories
# ==========================================
# DATA_RAW=${PROJECT_ROOT}/data/raw
# DATA_PROCESSED=${PROJECT_ROOT}/data/processed
# DATABASE_DIR=${PROJECT_ROOT}/database
# GEOSPATIAL_ASSETS=${PROJECT_ROOT}/geospatial_assets

# ==========================================
# Geospatial Configuration
# ==========================================
# OSM cache directory
# OSMNX_CACHE=${PROJECT_ROOT}/cache

# Lagos bounding box (min_lon, min_lat, max_lon, max_lat)
# LAGOS_BBOX=3.3,6.4,3.7,6.6

# ==========================================
# Optimization Configuration
# ==========================================
# OR-Tools solver parameters
# SOLVER_TYPE=CLP
# TIME_LIMIT_SECONDS=300

# ==========================================
# Logging
# ==========================================
# LOG_LEVEL=INFO
# LOG_FILE=${PROJECT_ROOT}/logs/dispatch.log
